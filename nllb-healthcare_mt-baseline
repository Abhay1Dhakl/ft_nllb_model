    "MAX_LENGTH = 128\n",
    "\n",
    "def preprocess(example):\n",
    "    source_texts = [ex[\"en\"] for ex in example[\"translation\"]]\n",
    "    target_texts = [ex[\"ne\"] for ex in example[\"translation\"]]\n",
    "\n",
    "    inputs = tokenizer(\n",
    "        source_texts,\n",
    "        max_length=MAX_LENGTH,\n",
    "        truncation=True,\n",
    "        padding=\"max_length\"\n",
    "    )\n",
    "\n",
    "    targets = tokenizer(\n",
    "        text_target=target_texts,\n",
    "        max_length=MAX_LENGTH,\n",
    "        truncation=True,\n",
    "        padding=\"max_length\"\n",
    "    )\n",
    "\n",
    "    labels = targets[\"input_ids\"]\n",
    "\n",
    "    labels = [\n",
    "        [(token if token != tokenizer.pad_token_id else -100) for token in label]\n",
    "        for label in labels\n",
    "    ]\n",
    "\n",
    "    inputs[\"labels\"] = labels\n",
    "\n",
    "    return inputs"
   ]
